DATABASE_URL=postgresql://user:pass@host:5432/dosarfonduri
REDIS_URL=redis://default:pass@host:6379
JWT_SECRET=your-jwt-secret-min-32-chars
PROVIDER_JWT_SECRET=your-provider-jwt-secret
ANTHROPIC_API_KEY=sk-ant-...
LISTAFIRME_API_KEY=your-listafirme-api-key
FRONTEND_URL=http://localhost:3000
PORT=8080

# S3/R2 Storage (optional — falls back to local filesystem if not set)
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=dosarfonduri
S3_REGION=auto
