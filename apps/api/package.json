{
  "name": "@dosarfonduri/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/jobs/worker.ts",
    "build": "tsc",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "start:worker": "node dist/jobs/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "dotenv": "^16.4.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "uuid": "^11.0.0",
    "@dosarfonduri/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.0"
  }
}
